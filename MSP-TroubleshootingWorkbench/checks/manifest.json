{
  "schemaVersion": 1,
  "checks": [
    {
      "checkId": "network.quick",
      "name": "Network Quick Check",
      "category": "Network",
      "script": "Invoke-NetworkQuickCheck.ps1",
      "description": "Ping, DNS, TCP port, and local route snapshot.",
      "readOnly": true,
      "inputs": [
        "targetAddress",
        "port"
      ]
    },
    {
      "checkId": "ad.lockout",
      "name": "AD Lockout Diagnostics",
      "category": "Active Directory",
      "script": "Invoke-ADLockoutCheck.ps1",
      "description": "Wraps the AD account lockout diagnostics report for a user.",
      "readOnly": true,
      "inputs": [
        "affectedUser",
        "daysBack",
        "domainController"
      ]
    }
  ]
}
